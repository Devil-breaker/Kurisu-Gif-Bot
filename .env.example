# Required
BOT_TOKEN=your_telegram_bot_token_from_botfather

# Required: Comma-separated bot admin user IDs (can manage GIFs and expressions)
ADMIN_IDS=123456789,987654321

# Optional: Bot owner ID (has full access, can manage admins)
# Get your ID from @userinfobot or @getidsbot
BOT_OWNER_ID=

# Optional: Private dump channel ID (e.g., -1001234567890)
# The bot must be an admin of this channel for auto-ingestion to work
DUMP_CHANNEL_ID=

# Optional: A secret string you choose — used to verify that webhook calls
# really come from Telegram (set the same value when calling setWebhook)
WEBHOOK_SECRET=your_random_secret_here

# Optional: Saucenao API key (get free at https://saucenao.com/account.php)
SAUCENAO_API_KEY=

# Turso DB (get free at https://turso.tech)
# Local development: leave TURSO_URL empty to use file-based SQLite
# Production: set both values
TURSO_URL=
TURSO_AUTH_TOKEN=

# Optional: expression-specific channel mapping in JSON array form
# e.g. [{"channel_id": -100123, "expression": "hug"}, {"channel_id": -100456, "expression": "kiss"}]
CHANNEL_EXPRESSION_MAP=
